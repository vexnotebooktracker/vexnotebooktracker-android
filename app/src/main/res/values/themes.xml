<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme using Material 3 -->
    <style name="AppTheme" parent="Theme.Material3.Light">
        <!-- VEX Brand Colors -->
        <item name="colorPrimary">@color/vex_orange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/vex_light_orange</item>
        <item name="colorOnPrimaryContainer">@color/vex_blue</item>

        <item name="colorSecondary">@color/vex_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/vex_light_blue</item>
        <item name="colorOnSecondaryContainer">@color/vex_blue</item>

        <item name="colorTertiary">@color/vex_gray</item>
        <item name="colorOnTertiary">@color/white</item>

        <!-- Surface colors -->
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/background_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/white</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <!-- Status bar -->
        <!--
            android:statusBarColor and android:navigationBarColor are ignored on Android 16
            (API 36) because edge-to-edge is enforced for apps targeting SDK 36. The status bar
            area is now painted by each screen's own app bar (or by the login screen's
            statusBarScrim), and the bar icon colour is set with enableEdgeToEdge() in each
            activity. Kept commented out for reference.
        -->
        <!-- <item name="android:statusBarColor">@color/vex_orange</item> -->
        <!-- <item name="android:windowLightStatusBar">false</item> -->

        <!-- Action bar -->
        <item name="colorSurfaceContainer">@color/vex_orange</item>
    </style>

    <!-- Theme without action bar -->
    <style name="AppTheme.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/vex_orange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/vex_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <!-- Ignored on Android 16 (API 36) - see the note in AppTheme above. -->
        <!-- <item name="android:statusBarColor">@color/vex_orange</item> -->
    </style>

    <!--
        Delete Profile dialog: always light. AppTheme.NoActionBar is DayNight, and the Material 3
        dialog paints its background with colorSurfaceContainerHigh, so without this overlay the
        dialog turned dark on phones in night mode (incl. scheduled / battery-saver dark mode).
    -->
    <style name="ThemeOverlay.App.DeleteProfileDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/red</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/vex_gray</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>