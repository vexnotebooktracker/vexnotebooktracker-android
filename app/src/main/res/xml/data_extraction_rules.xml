<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive data from cloud backup -->
        <exclude domain="sharedpref" path="vex_secure_prefs" />
        <exclude domain="sharedpref" path="vex_prefs" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude sensitive data from device transfer -->
        <exclude domain="sharedpref" path="vex_secure_prefs" />
        <exclude domain="sharedpref" path="vex_prefs" />
    </device-transfer>
</data-extraction-rules>