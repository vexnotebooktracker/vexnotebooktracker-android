<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="@dimen/padding_small">

    <!-- Main Content Row (Horizontal) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Field Name -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawablePadding="@dimen/padding_small"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            tools:text="Short URL" />

        <!-- Field Value - LEFT ALIGNED - MONOSPACE FONT (ENFORCED) -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:gravity="start|center_vertical"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/text_secondary"
            android:layout_marginEnd="8dp"
            android:drawablePadding="@dimen/padding_small"
            android:fontFamily="monospace"
            android:typeface="monospace"
            tools:text="example-short-url-20" />

        <!-- Copy Icon (only visible for URL rows) -->
        <ImageView
            android:id="@+id/ivCopy"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_copy"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:contentDescription="@string/copy_url_description"
            android:visibility="invisible"
            app:tint="@color/vex_orange"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Full-Width Separator (only visible for separator rows) -->
    <View
        android:id="@+id/separator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/vex_light_gray"
        android:visibility="gone" />

</LinearLayout>