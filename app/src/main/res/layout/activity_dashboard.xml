<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".ui.dashboard.DashboardActivity">

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar">

        <!-- FIRST LEVEL: App Icon + Action Buttons (Profile, Delete, Contact, About) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/vex_orange"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/padding_medium"
            android:paddingEnd="@dimen/padding_small">

            <!-- Application Icon -->
            <ImageView
                android:id="@+id/ivAppIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:layout_marginEnd="@dimen/margin_small" />

            <!-- Spacer to push buttons to the right -->
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Profile Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditProfile"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/profile_button_text"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_person"
                app:iconTint="@color/white"
                app:iconSize="16dp"
                app:iconPadding="4dp" />

            <!-- Delete Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteProfile"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/delete"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_close"
                app:iconTint="@color/white"
                app:iconSize="16dp"
                app:iconPadding="4dp" />

            <!-- Contact Button - ICON ONLY -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContact"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/contact_support_description"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_email"
                app:iconTint="@color/white"
                app:iconSize="20dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <!-- About Button - ICON ONLY -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbout"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/about_app_description"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_info"
                app:iconTint="@color/white"
                app:iconSize="20dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <!-- API Data Table -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- SECOND LEVEL: My Notebooks Title and Register Button (NO ICONS) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/padding_medium"
                        android:gravity="center_vertical"
                        android:background="@color/header_background">

                        <!-- My Notebooks Title (NO ICON) -->
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvTableTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/my_notebooks_title"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="@color/vex_blue"
                            android:textStyle="bold" />

                        <!-- Register Notebook Button (NO ICON) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegister"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/register_notebook_button"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            app:backgroundTint="@color/vex_orange"
                            app:cornerRadius="@dimen/button_corner_radius" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/vex_light_gray" />

                    <!-- RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="5"
                        tools:listitem="@layout/item_table_row" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Logout Button with visible icon -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginBottom="@dimen/margin_large"
                android:text="@string/sign_out_button"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_button"
                android:backgroundTint="@color/vex_orange"
                app:cornerRadius="@dimen/button_corner_radius"
                app:icon="@drawable/ic_logout"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:iconPadding="8dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/margin_medium"
        android:layout_marginBottom="@dimen/margin_medium"
        android:contentDescription="@string/refresh_data_description"
        app:srcCompat="@drawable/ic_refresh"
        app:tint="@color/white"
        app:backgroundTint="@color/vex_orange" />

    <!-- Progress Bar -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/vex_orange"
        tools:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>